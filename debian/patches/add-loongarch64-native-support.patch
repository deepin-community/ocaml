+		STORE   $a1, $sp, 0x18
+		STORE   $a2, $sp, 0x20
+		STORE   $a3, $sp, 0x28
+		STORE   $a4, $sp, 0x30
+		STORE   $a5, $sp, 0x38
+		STORE   $a6, $sp, 0x40
