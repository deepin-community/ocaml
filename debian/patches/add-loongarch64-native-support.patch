+		fst.d     $fs1, $sp, 0x50
+		fst.d     $fs2, $sp, 0x58
+		fst.d     $fs3, $sp, 0x60
+		fst.d     $fs4, $sp, 0x68
+		fst.d     $fs5, $sp, 0x70
+		fst.d     $fs6, $sp, 0x78
