+        CFI_ADJUST(0xa0)
+		STORE   $ra, $sp, 0x90
+        CFI_OFFSET(ra, -0xa0+0xb0)
+		STORE   $s0, $sp, 0x0
+		STORE   $s1, $sp, 0x8
+		STORE   $s2, $sp, 0x10
+		STORE   $s3, $sp, 0x18
+		STORE   $s4, $sp, 0x20
+		STORE   $s5, $sp, 0x28
+		STORE   $s6, $sp, 0x30
+		STORE   $s7, $sp, 0x38
+		STORE   $s8, $sp, 0x40
