+        STORE   TMP, Caml_state(bottom_of_stack)
+        LOAD    TMP, $sp, 8
+        STORE   TMP, Caml_state(last_return_address)
+        LOAD    TMP, $sp, 16
+        STORE   TMP, Caml_state(gc_regs)
